{
  // Configuration Cloudflare du Pack Preparation CDI (mode cloud / mobile)
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "prep-cdi",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  // Pas d'URL de previsualisation publique : seule l'URL protegee par Access existe
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Le Worker voit toutes les requetes : le verrou Access s'applique aussi a l'interface
    "run_worker_first": true
  },
  "r2_buckets": [{ "binding": "AUDIOS", "bucket_name": "prep-cdi-audios" }],
  "durable_objects": {
    "bindings": [{ "name": "USER_DATA", "class_name": "UserDataObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserDataObject"] }],
  "observability": { "enabled": true }
}
